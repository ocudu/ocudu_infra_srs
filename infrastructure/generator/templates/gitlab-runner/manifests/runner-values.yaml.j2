image:
  registry: {{ cluster_config.gitlab_runner.image.registry }}
  image: {{ cluster_config.gitlab_runner.image.image }}
  tag: {{ cluster_config.gitlab_runner.image.tag }}

imagePullPolicy: IfNotPresent

{% if cluster_config.gitlab_runner.image_pull_secrets %}
imagePullSecrets:
{% for secret in cluster_config.gitlab_runner.image_pull_secrets %}
  - name: "{{ secret }}"
{% endfor %}
{% else %}
imagePullSecrets: []
{% endif %}

gitlabUrl: {{ cluster_config.gitlab_runner.gitlab_url }}

runnerToken: "{{ runner.token }}"

{% if runner.unregister_runners is defined %}
unregisterRunners: {{ runner.unregister_runners | lower }}
{% else %}
unregisterRunners: false
{% endif %}

terminationGracePeriodSeconds: {{ runner.termination_grace_period_seconds | default(3600) }}

concurrent: {{ runner.concurrent }}

checkInterval: {{ runner.check_interval | default(1) }}

sessionServer:
  enabled: {{ runner.session_server_enabled | default(false) | lower }}
{% if runner.session_server_timeout %}
  timeout: {{ runner.session_server_timeout }}
{% endif %}
{% if runner.session_server_internal_port %}
  internalPort: {{ runner.session_server_internal_port }}
{% endif %}
{% if runner.session_server_external_port %}
  externalPort: {{ runner.session_server_external_port }}
{% endif %}
{% if runner.session_server_public_ip %}
  publicIP: "{{ runner.session_server_public_ip }}"
{% endif %}
{% if runner.session_server_load_balancer_source_ranges %}
  loadBalancerSourceRanges:
{% for range in runner.session_server_load_balancer_source_ranges %}
    - "{{ range }}"
{% endfor %}
{% endif %}

rbac:
  create: true
{% set rbac_rules = runner.rbac.rules if runner.rbac and runner.rbac.rules else (cluster_config.gitlab_runner.rbac.rules if cluster_config.gitlab_runner.rbac and cluster_config.gitlab_runner.rbac.rules else []) %}
  rules: {{ rbac_rules | tojson }}
{% set rbac_cluster_wide = runner.rbac.clusterWideAccess if runner.rbac and runner.rbac.clusterWideAccess is defined else (cluster_config.gitlab_runner.rbac.clusterWideAccess if cluster_config.gitlab_runner.rbac and cluster_config.gitlab_runner.rbac.clusterWideAccess is defined else false) %}
  clusterWideAccess: {{ rbac_cluster_wide | lower }}
  podSecurityPolicy:
    enabled: false
    resourceNames:
    - gitlab-runner
{% set rbac_annotations = runner.rbac.serviceAccountAnnotations if runner.rbac and runner.rbac.serviceAccountAnnotations else (cluster_config.gitlab_runner.rbac_service_account_annotations if cluster_config.gitlab_runner.rbac_service_account_annotations else None) %}
{% if rbac_annotations %}
  serviceAccountAnnotations:
{% for key, value in rbac_annotations.items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}

metrics:
  enabled: {{ runner.metrics_enabled | default(false) | lower }}
  portName: metrics
  port: 9252
  serviceMonitor:
    enabled: false

service:
  enabled: false
  type: ClusterIP

runners:
  config: |
    [[runners]]
      output_limit = {{ runner.output_limit | default(10485760) }}
      environment = [{% if runner.environment %}{% for env in runner.environment %}"{{ env }}"{% if not loop.last %}, {% endif %}{% endfor %}{% else %}{% if runner.cpu_limit %}"SRS_CPU_LIMIT={{ runner.cpu_limit }}"{% if runner.memory_limit %}, {% endif %}{% endif %}{% if runner.memory_limit %}"SRS_MEMORY_LIMIT={{ runner.memory_limit }}"{% endif %}{% if runner.cpu_limit or runner.memory_limit %}, {% endif %}"GIT_HTTP_POST_BUFFER=157286400"{% endif %}]
      [runners.feature_flags]
        FF_TIMESTAMPS = true
        FF_PRINT_POD_EVENTS = true
        FF_SCRIPT_SECTIONS = true
      [runners.cache]
        Type = "{{ cluster_config.gitlab_runner.cache.type }}"
        Path = "{{ cluster_config.gitlab_runner.cache.path }}"
        Shared = true
        [runners.cache.{{ cluster_config.gitlab_runner.cache.type }}]
{% if cluster_config.gitlab_runner.cache.type == "s3" %}
          ServerAddress = "{{ cluster_config.gitlab_runner.cache.s3.server_address }}"
          AccessKey = "{{ cluster_config.gitlab_runner.cache.s3.access_key }}"
          SecretKey = "{{ cluster_config.gitlab_runner.cache.s3.secret_key }}"
          BucketName = "{{ cluster_config.gitlab_runner.cache.s3.bucket_name }}"
          Insecure = {{ cluster_config.gitlab_runner.cache.s3.insecure | lower }}
{% endif %}
      [runners.kubernetes]
        cache_dir = "/cache"
        namespace = "{{ '{{' }}.Release.Namespace{{ '}}' }}"
        privileged = true
        poll_timeout = {{ runner.poll_timeout | default(1200) }}
        helper_image_flavor = "ubuntu"
        dns_policy = "default"
        image = "{{ runner.build_image | default('ubuntu') }}"
{% if runner.pull_policy %}
        pull_policy = "{{ runner.pull_policy }}"
{% endif %}
{% if runner.service_account %}
        service_account = "{{ runner.service_account }}"
{% endif %}
{% if runner.service_account_overwrite_allowed is defined and runner.service_account_overwrite_allowed is not none %}
        service_account_overwrite_allowed = {{ runner.service_account_overwrite_allowed | lower }}
{% endif %}
{% if runner.priority_class_name %}
        priority_class_name = "{{ runner.priority_class_name }}"
{% endif %}
{% if runner.helper_image %}
        helper_image = "{{ runner.helper_image }}"
{% endif %}
{% if runner.cpu_request %}
            cpu_request = "{{ runner.cpu_request }}"
{% endif %}
{% if runner.cpu_limit %}
            cpu_limit = "{{ runner.cpu_limit }}"
{% endif %}
            cpu_request_overwrite_max_allowed = "{{ runner.cpu_request_overwrite_max_allowed | default(20) }}"
            cpu_limit_overwrite_max_allowed = "{{ runner.cpu_limit_overwrite_max_allowed | default(20) }}"
{% if runner.memory_request %}
            memory_request = "{{ runner.memory_request }}"
{% endif %}
{% if runner.memory_limit %}
            memory_limit = "{{ runner.memory_limit }}"
{% endif %}
            memory_request_overwrite_max_allowed = "{{ runner.memory_request_overwrite_max_allowed | default('20Gi') }}"
            memory_limit_overwrite_max_allowed = "{{ runner.memory_limit_overwrite_max_allowed | default('20Gi') }}"
{% if runner.ephemeral_storage_request %}
            ephemeral_storage_request = "{{ runner.ephemeral_storage_request }}"
{% endif %}
{% if runner.ephemeral_storage_limit %}
            ephemeral_storage_limit = "{{ runner.ephemeral_storage_limit }}"
{% endif %}
            ephemeral_storage_request_overwrite_max_allowed = "{{ runner.ephemeral_storage_request_overwrite_max_allowed | default('200Gi') }}"
            ephemeral_storage_limit_overwrite_max_allowed = "{{ runner.ephemeral_storage_limit_overwrite_max_allowed | default('200Gi') }}"
            service_cpu_limit = "{{ runner.service_cpu_limit | default('1') }}"
            service_memory_limit = "{{ runner.service_memory_limit | default('1Gi') }}"
            helper_cpu_limit = "{{ runner.helper_cpu_limit | default('500m') }}"
            helper_memory_limit = "{{ runner.helper_memory_limit | default('500Mi') }}"
{% if runner.pod_security_context %}
      [runners.kubernetes.pod_security_context]
{% if runner.pod_security_context.run_as_non_root is defined %}
        run_as_non_root = {{ runner.pod_security_context.run_as_non_root | lower }}
{% endif %}
{% if runner.pod_security_context.run_as_user %}
        run_as_user = {{ runner.pod_security_context.run_as_user }}
{% endif %}
{% if runner.pod_security_context.run_as_group %}
        run_as_group = {{ runner.pod_security_context.run_as_group }}
{% endif %}
{% if runner.pod_security_context.fs_group %}
        fs_group = {{ runner.pod_security_context.fs_group }}
{% endif %}
{% if runner.pod_security_context.supplemental_groups %}
        supplemental_groups = [{% for group in runner.pod_security_context.supplemental_groups %}{{ group }}{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif %}
{% endif %}
{% if runner.volumes %}
{% for volume in runner.volumes %}
{% if volume.type == "empty_dir" %}
      [[runners.kubernetes.volumes.empty_dir]]
        name = "{{ volume.name }}"
        mount_path = "{{ volume.mount_path }}"
{% if volume.medium %}
        medium = "{{ volume.medium }}"
{% endif %}
{% elif volume.type == "pvc" %}
      [[runners.kubernetes.volumes.pvc]]
        name = "{{ volume.name }}"
        mount_path = "{{ volume.mount_path }}"
{% elif volume.type == "host_path" %}
      [[runners.kubernetes.volumes.host_path]]
        name = "{{ volume.name }}"
        mount_path = "{{ volume.mount_path }}"
        host_path = "{{ volume.host_path }}"
{% elif volume.type == "secret" %}
      [[runners.kubernetes.volumes.secret]]
        name = "{{ volume.name }}"
        mount_path = "{{ volume.mount_path }}"
        read_only = {{ volume.read_only | default(true) | lower }}
{% elif volume.type == "config_map" %}
      [[runners.kubernetes.volumes.config_map]]
        name = "{{ volume.name }}"
        mount_path = "{{ volume.mount_path }}"
{% endif %}
{% endfor %}
{% endif %}
{% set host_aliases = runner.host_aliases if runner.host_aliases else (cluster_config.gitlab_runner.host_aliases if cluster_config.gitlab_runner.host_aliases else None) %}
{% if host_aliases %}
      [[runners.kubernetes.host_aliases]]
        ip = "{{ host_aliases.ip }}"
        hostnames = [{% for hostname in host_aliases.hostnames %}"{{ hostname }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif %}
      [runners.kubernetes.node_selector]
{% if runner.node_selector %}
{% for key, value in runner.node_selector.items() %}
        "{{ key }}" = "{{ value }}"
{% endfor %}
{% else %}
        "kubernetes.io/arch" = "{{ runner.arch | default('amd64') }}"
        "kubernetes.io/os" = "linux"
{% endif %}
{% if runner.node_tolerations %}
      [runners.kubernetes.node_tolerations]
{% for key, value in runner.node_tolerations.items() %}
        "{{ key }}" = "{{ value }}"
{% endfor %}
{% endif %}
{% if runner.clone_url %}
      clone_url = "{{ runner.clone_url }}"
{% endif %}

  tags: "{{ runner.tags }}"
  name: "{{ runner.name }}"
  runUntagged: {{ runner.run_untagged | default(false) | lower }}
  privileged: false

cache: {}

builds: {}

services: {}

helpers: {}

securityContext:
  allowPrivilegeEscalation: false
  readOnlyRootFilesystem: false
  runAsNonRoot: true
  privileged: false
  capabilities:
    drop: ["ALL"]

podSecurityContext:
  runAsUser: 999
  fsGroup: 999

resources: {}

affinity: {}

nodeSelector: {}

tolerations:
  - key: "srs.io/mgmt-glr-runner"
    operator: "Exists"
    effect: "NoSchedule"

hostAliases: []

podAnnotations: {}

podLabels: {}

{% if runner.priority_class_name %}
priorityClassName: "{{ runner.priority_class_name }}"
{% else %}
priorityClassName: ""
{% endif %}

secrets: []

configMaps: {}

volumeMounts: []

volumes: []
