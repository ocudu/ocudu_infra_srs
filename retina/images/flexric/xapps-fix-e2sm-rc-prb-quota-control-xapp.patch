+// The PLMN Identity RAN parameter is an OCTET STRING (SIZE(3)) carrying the BCD encoding of TS 38.413 9.3.3.5, not
+// the decimal string. PLMN "00101" (MCC=001, MNC=01) is 0x00 0xF1 0x10.
 static
-void gen_rrm_policy_ratio_group(lst_ran_param_t* RRM_Policy_Ratio_Group,
-                                const char* sst_str,
-                                const char* sd_str,
+byte_array_t plmn_str_to_ba(const char* plmn_str)
+{
+  const size_t sz = strlen(plmn_str);
+  assert((sz == 5 || sz == 6) && "PLMN is MCC (3 digits) followed by MNC (2 or 3 digits)");
+
+  uint8_t digit[6] = {0};
+  for (size_t i = 0; i < sz; i++) {
+    assert(plmn_str[i] >= '0' && plmn_str[i] <= '9' && "PLMN digits must be decimal");
+    digit[i] = (uint8_t)(plmn_str[i] - '0');
+  }
+
+  // For a 2-digit MNC, the unused MNC digit 1 nibble carries the 0xf filler.
+  const uint8_t mnc_1 = (sz == 5) ? 0xf : digit[3];
+  const uint8_t mnc_2 = (sz == 5) ? digit[3] : digit[4];
+  const uint8_t mnc_3 = (sz == 5) ? digit[4] : digit[5];
+
+  byte_array_t dst = {.len = 3};
+  dst.buf = calloc(dst.len, sizeof(uint8_t));
+  assert(dst.buf != NULL && "Memory exhausted");
+  dst.buf[0] = (uint8_t)((digit[1] << 4) | digit[0]); // MCC digit 2 | MCC digit 1
+  dst.buf[1] = (uint8_t)((mnc_1 << 4) | digit[2]);    // MNC digit 1 | MCC digit 3
+  dst.buf[2] = (uint8_t)((mnc_3 << 4) | mnc_2);       // MNC digit 3 | MNC digit 2
+
+  return dst;
+}
