SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
SPDX-License-Identifier: BSD-3-Clause-Open-MPI
#}

gnb_id: {{gnb_id}}

log:
  filename: {{log_filename}}
  all_level: {{log_level}}
  lib_level: {{log_level}}
  {%- if log_phy_level %}
  phy_level: {{log_phy_level}}
  {%- endif %}
  {%- if log_mac_level %}
  mac_level: {{log_mac_level}}
  {%- endif %}
  {%- if log_broadcast_enabled %}
  broadcast_enabled: {{log_broadcast_enabled}}
  {%- endif %}
  {%- if log_gtpu_level %}
  gtpu_level: {{log_gtpu_level}}
  {%- endif %}
  {%- if du_ip or not cucp_ip %}
  rlc_level: {{log_rlc_level}}
  {%- endif %}
  config_level: debug
  {%- if flush_app_banner %}
  flush_app_banner: true
  {%- endif %}

metrics:
  enable_log: true

{# DU #}
{% if du_ip %}
f1ap:
  addrs: {{cucp_ip}}
  bind_addrs: {{du_ip}}
f1u:
  bind_port: {{f1u_port}}
  peer_port: {{f1u_port}}
  socket:
    -
      bind_addr: {{du_ip}}
{% else %}

{# CU #}
{% if cucp_ip and cucp_ip == cuup_ip %}
cu_cp:
  f1ap:
    bind_addrs: {{cucp_ip}}
    procedure_timeout: 10000
  rrc:
    rrc_procedure_guard_time_ms: 10000
cu_up:
  f1u:
    bind_port: {{f1u_port}}
    peer_port: {{f1u_port}}
    socket:
      -
        bind_addr: {{cuup_ip}}
{% endif %}

{# CU-CP #}
{% if cucp_ip and not cuup_ip %}
cu_cp:
  f1ap:
    bind_addrs: {{cucp_ip}}
    procedure_timeout: 10000
  rrc:
    rrc_procedure_guard_time_ms: 10000
  e1ap:
    bind_addrs: {{cucp_ip}}
{% endif %}

{# CU-UP #}
{% if cuup_ip and cucp_ip != cuup_ip %}
cu_up:
  f1u:
    bind_port: {{f1u_port}}
    peer_port: {{f1u_port}}
    socket:
      - bind_addr: {{cuup_ip}}

  e1ap:
    gateways:
  {% if cucp_definition|length > 0 %}
  {% for cucp in cucp_definition %}
      - bind_addrs: {{cuup_ip}}
        addrs: {{cucp.cucp_ip}}
  {% endfor %}
  {% else %}
      - bind_addrs: {{cuup_ip}}
        addrs: {{cucp_ip}}
  {% endif %}
  ngu:
    socket:
      - bind_addr: {{cuup_ip}}
{% endif %}
{% endif %}