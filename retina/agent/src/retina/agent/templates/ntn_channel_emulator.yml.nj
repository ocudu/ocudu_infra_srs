verbose: 0
log_level: 0

run_channel_emulator: True
use_saved_traces: False

ntn_scenario:
  tle_fn: {{tle_fn}}
  pass_start_offset: {{pass_start_offset_s}}
  min_sat_elevation: {{min_sat_elevation_deg}}
  pass_start_event: AOS   # AOS (Acquisition of Signal), TCA (Time of Closest Approach)
  pass_end_event: LOS     # TCA (Time of Closest Approach), LOS (Loss of Signal)
  channel_time_res: 1s
  use_accurate_sgp4_model: False

access_link:
  input_trace_csv_fn: /ntn-channel-emulator/traces/channel_trace.csv
  dl_freq_hz: {{al_dl_freq_hz}}
  ul_freq_hz: {{al_ul_freq_hz}}

feeder_link:
  enabled: {{enable_feeder_link}}
  input_trace_csv_fn: /ntn-channel-emulator/traces/fl_channel_trace.csv
  dl_freq_hz: {{fl_dl_freq_hz}}
  ul_freq_hz: {{fl_ul_freq_hz}}

emulator:
  sample_rate: {{sample_rate}}
  throttle_period: 1000
  use_multi_process: False
  print_channel_info: False
  enable_doppler: {{enable_doppler}}
  delay_offset: {{delay_offset_us}}  # Add a small offset to the computed link delay, PRACH will cope with it.
  links:
  - name: Downlink
    type: DL
    src_name: gNB
    dst_name: UE
    in_ip: {{gnb_zmq_ip}}
    in_port: {{gnb_zmq_port}}
    out_ip: {{ip_zmq}}
    out_port: {{port_array[0]}}
  - name: Uplink
    type: UL
    src_name: UE
    dst_name: gNB
    in_ip: {{ue_zmq_ip}}
    in_port: {{ue_zmq_port}}
    out_ip: {{ip_zmq}}
    out_port: {{port_array[1]}}

sib19:
    sib19_format: {{sib19_format}}
    enable_updater: False
    input_trace_csv_fn: /ntn-channel-emulator/traces/sib19_trace.csv
    ip: 127.0.0.1
    port: 12345

configs:
    gnb:
      ntn_config_fn: {{gnb_ntn_config_fn}}
    ue:
      position_fn: {{ue_position_fn}}
      amariue_position_fn: {{amariue_position_fn}}
      gs_position_fn: {{amariue_gs_position_fn}}

output_traces:
    enable: False
    channel_trace_csv_fn: /ntn-channel-emulator/traces/channel_trace.csv
    fl_channel_trace_csv_fn: /ntn-channel-emulator/traces/fl_channel_trace.csv
    sib19_trace_csv_fn: /ntn-channel-emulator/traces/sib19_trace.csv
