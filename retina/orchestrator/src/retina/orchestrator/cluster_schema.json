{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "networking-mode": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "dnsPolicy": {
          "type": "string",
          "enum": [
            "Default",
            "ClusterFirst",
            "ClusterFirstWithHostNet",
            "None"
          ]
        }
      },
      "required": [
        "name",
        "networking-mode",
        "version"
      ]
    },
    "cluster_resource_list": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/cluster_resource"
      },
      "description": "List of cluster resources. Each combination of 'type' and 'model' must be unique across all items."
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      }
    }
  },
  "required": [
    "global",
    "cluster_resource_list",
    "nodes"
  ],
  "definitions": {
    "cluster_resource": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "model"
      ]
    },
    "node": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "compute-resources": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "integer"
            },
            "memory": {
              "type": "string"
            },
            "ephemeral-storage": {
              "type": "string"
            },
            "hugepages-1Gi": {
              "type": "string"
            }
          }
        },
        "model": {
          "type": "string"
        },
        "cpu_isolation": {
          "$ref": "#/definitions/cpu_isolation"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/node_resource"
          }
        }
      },
      "required": [
        "name",
        "type",
        "compute-resources"
      ]
    },
    "cpu_isolation": {
      "type": "object",
      "properties": {
        "lcores_eal_args": {
          "type": "string"
        }
      }
    },
    "node_resource": {
      "oneOf": [
        {
          "$ref": "#/definitions/android_resource"
        },
        {
          "$ref": "#/definitions/sdr_resource"
        },
        {
          "$ref": "#/definitions/ru_resource"
        },
        {
          "$ref": "#/definitions/accelerator_resource"
        }
      ]
    },
    "android_resource": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "android"
        },
        "model": {
          "type": "string"
        },
        "space": {
          "type": "integer"
        },
        "serial_id": {
          "type": "string"
        },
        "imsi": {
          "type": "string"
        },
        "k": {
          "type": "string"
        },
        "amf": {
          "type": "string"
        },
        "opc": {
          "type": "string"
        },
        "adb_key": {
          "type": "string"
        },
        "connection": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "model",
        "space",
        "serial_id",
        "imsi",
        "k",
        "amf",
        "opc",
        "adb_key"
      ],
      "additionalProperties": false
    },
    "sdr_resource": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "sdr"
        },
        "model": {
          "type": "string"
        },
        "space": {
          "type": "integer"
        },
        "args": {
          "type": "string"
        },
        "sample_rate": {
          "type": "integer"
        },
        "tx_gain": {
          "type": "integer"
        },
        "rx_gain": {
          "type": "integer"
        },
        "sync": {
          "type": "string"
        },
        "connection": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "model",
        "space",
        "args",
        "sample_rate",
        "tx_gain",
        "rx_gain",
        "sync"
      ],
      "additionalProperties": false
    },
    "ru_resource": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ru"
        },
        "model": {
          "type": "string"
        },
        "space": {
          "type": "integer"
        },
        "address": {
          "type": "string"
        },
        "network_interface": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ru_mac_address": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "du_mac_address": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vlan_tag_up": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vlan_tag_cp": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prach_port_id": {
          "type": "string"
        },
        "dl_port_id": {
          "type": "string"
        },
        "ul_port_id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "model",
        "space",
        "address",
        "network_interface",
        "ru_mac_address",
        "du_mac_address",
        "vlan_tag_up",
        "vlan_tag_cp",
        "prach_port_id",
        "dl_port_id",
        "ul_port_id"
      ],
      "additionalProperties": false
    },
    "accelerator_resource": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "accelerator"
        },
        "model": {
          "type": "string"
        },
        "space": {
          "type": "integer"
        },
        "id": {
          "type": "integer"
        },
        "cb_mode": {
          "type": "boolean"
        },
        "hwacc_type": {
          "type": "string"
        },
        "pdsch_enc_nof_hwacc": {
          "type": "integer"
        },
        "pusch_dec_nof_hwacc": {
          "type": "integer"
        },
        "harq_context_size": {
          "type": "integer"
        },
        "args": {
          "type": "string"
        },
        "connection": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "model",
        "space",
        "id",
        "cb_mode",
        "hwacc_type",
        "pdsch_enc_nof_hwacc",
        "pusch_dec_nof_hwacc",
        "harq_context_size",
        "args"
      ],
      "additionalProperties": false
    }
  }
}