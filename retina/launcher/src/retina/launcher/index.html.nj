<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@10.2.1/build/styles/default.min.css">
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/markdown-it/11.0.1/markdown-it.min.js "></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/10.2.1/highlight.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <script type="text/javascript">
        document.querySelectorAll("code").forEach(function(element) {
            element.innerHTML = element.innerHTML.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        });
        hljs.initHighlightingOnLoad();
    </script>

    <div class="container">
    <br>

    <a href="{{path_to_main_html}}" class="btn btn-light">&laquo; Back global report</a>
    <br>
    <br>

    <div class="alert alert-primary" role="alert">
        <h4>{{test_name}}</h4>
    </div>

{% for output_inst in output_list -%}
    <div class="card">
        <h5 class="card-header">{{output_inst["name"]}}</h5>
        <div class="card-body">
            <ul>
{% for o_inst in output_inst["output"] -%}
                <li>
                    <a style="margin-bottom:8px" href="{{o_inst["path_complete"]}}" target="_blank" download="{{o_inst["simple_name"]}}" class="btn btn-light btn-sm"><i class="fa fa-download"></i> Download</a>    <a href="{{o_inst["path"]}}">{{o_inst["name"]}}</a>
                </li>
{% endfor %}
            </ul>
        </div>
    </div>
    <br>
{% endfor %}

    <h2>Test configuration</h2>
    <pre><code class="language-json">{{str_config}}</code></pre>

    <h2>Testbed</h2>
    <pre><code class="language-json">{{str_testbed  | replace("OrderedDict", "") | replace("_NodeInfo", "") | replace("\"", "") | replace("\\n", "") | replace(",,", ",")}}</code></pre>
    {# <pre><code class="language-json">{{str_testbed}}</code></pre> #}
    </div>
</html>
