---
extends: default

rules:
  line-length:
    max: 120
    level: warning
  document-start: disable
  indentation:
    spaces: 2
    indent-sequences: true
  key-duplicates: enable
  document-end: disable
  truthy:
    allowed-values: ["true", "false", "yes", "no"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  trailing-spaces: enable
  new-line-at-end-of-file: disable

ignore: |
  e2e/tests/test_mode/
